cranlogs::cran_downloads("GetDFPData2", from = Sys.Date() - 5*365)
Sys.Date() - 5*365
cranlogs::cran_downloads("GetDFPData2",
from = Sys.Date() - 5*365,
to = 'last-day')
cranlogs::cran_downloads("GetDFPData2",
from = as.character(Sys.Date() - 5*365),
to = 'last-day')
df_cran <- cranlogs::cran_downloads(c("GetDFPData2", "GetFREData"),
from = as.character(Sys.Date() - 5*365),
to = 'last-day')
View(df_cran)
library(ggplot2)
p <- ggplot(df_cran, aes(x = date, y = count)) +
geom_col()
p
p <- ggplot(df_cran, aes(x = date, y = count)) +
geom_col() +
facet_wrap(~package)
p
df_cran <- cranlogs::cran_downloads(c("GetDFPData2", "GetFREData"),
from = as.character(Sys.Date() - 5*365),
to = 'last-day')
library(ggplot2)
p <- ggplot(df_cran, aes(x = date, y = count)) +
geom_col() +
facet_wrap(~package) +
labs(title = "Downloados por dia") +
theme_light()
p
df_cran <- cranlogs::cran_downloads(c("GetDFPData2", "GetFREData"),
from = "2021-01-01",
to = 'last-day')
library(ggplot2)
p <- ggplot(df_cran, aes(x = date, y = count)) +
geom_col() +
facet_wrap(~package) +
labs(title = "Downloados por dia") +
theme_light()
p
by_month <- df_cran |>
dplyr::mutate(ref_month = format(date, "%Y-%m")) |>
dplyr::group_by(ref_month, package) |>
dplyr::summarise(count = sum(count)) +
dplyr::ungroup()
df_cran |>
dplyr::mutate(ref_month = format(date, "%Y-%m"))
df_cran |>
dplyr::mutate(ref_month = format(date, "%Y-%m"))
by_month <- df_cran |>
dplyr::mutate(ref_month = format(date, "%Y-%m")) |>
dplyr::group_by(ref_month, package) |>
dplyr::summarise(count = sum(count)) +
dplyr::ungroup()
by_month <- df_cran |>
dplyr::mutate(ref_month = format(date, "%Y-%m")) |>
dplyr::group_by(ref_month, package) |>
dplyr::summarise(count = sum(count)) |>
dplyr::ungroup()
df_cran <- cranlogs::cran_downloads(c("GetDFPData2", "GetFREData"),
from = "2021-01-01",
to = 'last-day')
by_month <- df_cran |>
dplyr::mutate(ref_month = format(date, "%Y-%m")) |>
dplyr::group_by(ref_month, package) |>
dplyr::summarise(count = sum(count)) |>
dplyr::ungroup()
library(ggplot2)
p <- ggplot(by_month, aes(x = ref_month, y = count)) +
geom_col() +
facet_wrap(~package) +
labs(title = "Downloads de pacotes por dia") +
theme_light()
p
df_cran <- cranlogs::cran_downloads(c("GetDFPData2", "GetFREData"),
from = "2021-01-01",
to = 'last-day')
by_month <- df_cran |>
dplyr::mutate(ref_month = as.Date(format(date, "%Y-%m-01"))) |>
dplyr::group_by(ref_month, package) |>
dplyr::summarise(count = sum(count)) |>
dplyr::ungroup()
library(ggplot2)
p <- ggplot(by_month, aes(x = ref_month, y = count)) +
geom_col() +
facet_wrap(~package) +
labs(title = "Downloads de pacotes por dia") +
theme_light()
p
